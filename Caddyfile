# Caddy s'occupe TOUT SEUL du certificat HTTPS (Let's Encrypt) dès que le
# DNS de myplaylog.cc pointe vers l'IP du VPS. Le www redirige vers l'apex.

www.myplaylog.cc {
    redir https://myplaylog.cc{uri} permanent
}

myplaylog.cc {
    # Compression partout SAUF sur le flux temps réel du chat : un flux SSE ne
    # se termine jamais, et le compresseur peut retenir les évènements dans son
    # tampon — les messages arriveraient par paquets, avec des secondes de
    # retard. Le reste du site reste compressé normalement.
    @compressible not path /api/chat/stream
    encode @compressible gzip zstd

    # L'API et les fichiers uploadés vont vers le backend Express.
    @backend path /api/* /uploads/*
    handle @backend {
        reverse_proxy server:4000 {
            # ÉCRASE X-Forwarded-For au lieu de compléter celui du client.
            # Les limites de débit du backend comptent par IP (cf.
            # server/src/middleware/rateLimit.js) : si on laissait passer
            # l'en-tête envoyé par le client, il suffirait d'en changer à
            # chaque requête pour ne jamais être compté. Ici, l'adresse vue
            # par Express est celle de la connexion, point.
            header_up X-Forwarded-For {remote_host}
        }
    }

    # Robots sociaux (aperçus de partage) sur les pages partageables : le
    # backend renvoie des balises Open Graph dynamiques (titre, image, infos).
    # Ces robots ne lisent que le <head> et n'exécutent pas de JS -> sans ça,
    # ils ne voient que les méta génériques de la SPA. Les vraies personnes
    # (autres User-Agent) tombent dans le `handle` suivant et reçoivent la SPA.
    @crawler {
        path /lists/* /u/* /game/* /clip/* /listen/* /mot
        header_regexp User-Agent (?i)(facebookexternalhit|facebot|WhatsApp|Twitterbot|Discordbot|TelegramBot|Slackbot|LinkedInBot|redditbot|Pinterest|SkypeUriPreview|vkShare|Embedly|Iframely|Googlebot|bingbot|Applebot|ia_archiver|Google-InspectionTool)
    }
    handle @crawler {
        reverse_proxy server:4000
    }

    # Tout le reste : les fichiers statiques du build React (SPA).
    handle {
        root * /srv

        # ⚠️ LE NAVIGATEUR GARDE CE QUI NE CHANGE JAMAIS. Sans en-tête de
        # cache, chaque visite redemandait le JavaScript (plusieurs centaines
        # de Ko) : au mieux un aller-retour pour s'entendre dire « inchangé »,
        # au pire tout le fichier. Les fichiers de /assets portent leur
        # empreinte dans le nom (index-DM1DVBZi.js) : un nouveau build = un
        # nouveau nom, on peut donc les garder un an.
        @hashed path /assets/*
        header @hashed Cache-Control "public, max-age=31536000, immutable"

        # Images, modèles 3D, polices, sons : une semaine (leur nom ne change
        # pas d'un build à l'autre, il faut qu'une mise à jour finisse par passer).
        @media path /tops/* /arcade/* /case/* /geo/* /sfx/* /fonts/* *.glb *.png *.webp *.jpg *.woff2 *.mp3
        header @media Cache-Control "public, max-age=604800"

        # La page elle-même et le service worker : toujours revérifiés, sinon
        # un déploiement mettrait des jours à arriver chez les gens.
        @fresh not path /assets/* /tops/* /arcade/* /case/* /geo/* /sfx/* /fonts/* *.glb *.png *.webp *.jpg *.woff2 *.mp3
        header @fresh Cache-Control "no-cache"

        try_files {path} /index.html
        # ⚠️ PAS DE `precompressed` : Caddy 2.10 sert alors les fichiers en
        # « 206 Partial Content », et le service worker du site refuse de mettre
        # en cache une réponse 206 (cf. client/public/sw.js). La compression à
        # la volée (`encode`, plus haut) répond en 200.
        file_server
    }
}
